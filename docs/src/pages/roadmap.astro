---
import { getEntry, render } from 'astro:content';
import Site from '../layouts/Site.astro';
import '../styles/compare.css';

const entry = await getEntry('pages', 'roadmap');
if (!entry) throw new Error('docs/src/content/pages/roadmap.md is missing');
const { Content } = await render(entry);
const limits = entry.data.limits ?? [];
const groups = (['Next', 'Later'] as const).map((status) => ({ status, items: limits.filter((l) => l.status === status) }));
---

<Site title="Roadmap | Lodestore" description={entry.data.description}>
	<main>
		<header class="cmp-hero">
			<div class="wrap rise">
				<h1>Roadmap</h1>
				<p class="lead">{entry.data.description}</p>
			</div>
		</header>
		<div class="wrap">
			<article class="prose rise">
				<Content />
				{
					groups
						.filter((g) => g.items.length > 0)
						.map((g) => (
							<>
								<h2 id={g.status.toLowerCase()}>{g.status}</h2>
								<ul class="limits">
									{g.items.map((l) => (
										<li>
											<span>{l.title}</span>
											<span class={g.status === 'Next' ? 'status-tag next' : 'status-tag'}>{g.status}</span>
											{l.note && <p>{l.note}</p>}
										</li>
									))}
								</ul>
							</>
						))
				}
			</article>
			<div class="cmp-foot rise">
				<a class="btn btn-primary" href="/docs/quickstart/">Protect a host in 10 minutes</a>
			</div>
		</div>
	</main>
</Site>
