---
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';

export async function getStaticPaths() {
	const entries = await getCollection('compare');
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, others: entries.filter((e) => e.id !== entry.id) } }));
}

const { entry, others } = Astro.props;
const { Content } = await render(entry);
const [lead, rival] = entry.data.title.split(' vs ');
---

<Site title={entry.data.title} description={entry.data.description}>
	<main>
		<header class="cmp-hero">
			<div class="wrap measure-wide rise">
				<h1>{lead} vs <span class="em">{rival}</span></h1>
				<p class="lead">{entry.data.description}</p>
			</div>
		</header>
		<div class="wrap">
			<article class="prose rise">
				<Content />
			</article>
			<div class="cmp-foot rise">
				<p class="muted">
					Also compare:
					{
						others.map((o, i) => (
							<>
								{i > 0 && ', '}
								<a class="more" href={`/compare/${o.id}/`}>
									{o.data.title}
								</a>
							</>
						))
					}
				</p>
				<a class="btn btn-primary" href="/docs/quickstart/">Protect a host in 10 minutes</a>
			</div>
		</div>
	</main>
</Site>
