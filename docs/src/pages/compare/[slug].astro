---
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import '../../styles/compare.css';

export async function getStaticPaths() {
	const entries = await getCollection('compare');
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, others: entries.filter((e) => e.id !== entry.id) } }));
}

const { entry, others } = Astro.props;
const { Content } = await render(entry);
const [lead, rival] = entry.data.title.split(' vs ');
const { asOf, sources } = entry.data;
const asOfDay = asOf?.toISOString().slice(0, 10);
---

<Site title={entry.data.title} description={entry.data.description}>
	<main>
		<header class="cmp-hero">
			<div class="wrap rise">
				<h1>{lead} vs <span class="em">{rival}</span></h1>
				<p class="lead">{entry.data.description}</p>
			</div>
		</header>
		<div class="wrap">
			<article class="prose rise">
				{asOfDay && <p class="cmp-asof">Facts about {rival} as of <time datetime={asOfDay}>{asOfDay}</time>.</p>}
				<Content />
				{
					sources && (
						<>
							<h2 id="sources">Sources</h2>
							<ul>
								{sources.map((s) => (
									<li>
										<a href={s.url}>{s.title}</a>, {s.version}
									</li>
								))}
							</ul>
						</>
					)
				}
			</article>
			<div class="cmp-foot rise">
				<p class="muted">
					Also compare:{' '}
					{
						others.map((o, i) => (
							<>
								{i > 0 && ', '}
								<a class="more" href={`/compare/${o.id}/`}>
									{o.data.title}
								</a>
							</>
						))
					}
				</p>
				<a class="btn btn-primary" href="/docs/quickstart/">Protect a host in 10 minutes</a>
			</div>
		</div>
	</main>
</Site>
