<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme">
	<svg class="ic-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
	<svg class="ic-sun" viewBox="0 0 24 24" aria-hidden="true"
		><circle cx="12" cy="12" r="4"></circle><path
			d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
		></path></svg
	>
</button>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--input);
		border-radius: 0.5rem;
		background: var(--card);
		color: var(--foreground);
		cursor: pointer;
	}
	svg {
		width: 1.125rem;
		height: 1.125rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	:global(:root[data-theme='dark']) .ic-moon,
	:global(:root:not([data-theme='dark'])) .ic-sun {
		display: none;
	}
</style>

<script>
	const root = document.documentElement;
	const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
	const label = () => {
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		toggles.forEach((b) => b.setAttribute('aria-label', `Switch to ${next} theme`));
	};
	label();
	toggles.forEach((b) =>
		b.addEventListener('click', () => {
			const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('starlight-theme', next);
			} catch {}
			label();
		}),
	);
</script>
