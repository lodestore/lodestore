---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	light: ImageMetadata;
	dark: ImageMetadata;
	alt: string;
	class?: string;
	widths?: number[];
	sizes?: string;
}

const { light, dark, alt, class: className, widths, sizes } = Astro.props;
---

<Image src={light} alt={alt} class:list={['only-light', className]} {widths} {sizes} loading="lazy" decoding="async" />
<Image src={dark} alt={alt} class:list={['only-dark', className]} {widths} {sizes} loading="lazy" decoding="async" />
