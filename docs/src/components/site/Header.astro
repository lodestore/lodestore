---
import { GITHUB_URL, navItems } from './nav';

const items = await navItems();
const github =
	'M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7c-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1 2.7c0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2Z';
---

<div class="pill-wrap">
	<div class="pill">
		<div class="pill-in">
			<a class="logo" href="/">
				<svg viewBox="0 0 32 32" aria-hidden="true"
					><path
						fill="#070A12"
						d="M16 2.8L27.43 9.4L27.43 22.6L16 29.2L4.57 22.6L4.57 9.4Z"
						stroke="#38E1FF"
						stroke-width="2.2"
						stroke-linejoin="round"></path><path
						fill="#38E1FF"
						d="M16 6.4L18 14L25.6 16L18 18L16 25.6L14 18L6.4 16L14 14Z"></path><path
						fill="#C6F24E"
						d="M16 12.4L16.9 15.1L19.6 16L16.9 16.9L16 19.6L15.1 16.9L12.4 16L15.1 15.1Z"></path></svg
				>Lodestore
			</a>
			<nav class="nav" id="site-nav" aria-label="Main">
				{items.map((i) => <a href={i.href}>{i.label}</a>)}
				<div class="menu-extra">
					<button class="icon-btn" type="button" data-theme-toggle aria-label="Switch to dark theme">
						<svg class="icon ic-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
						<svg class="icon ic-sun" viewBox="0 0 24 24"
							><circle cx="12" cy="12" r="4"></circle><path
								d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
							></path></svg
						>
					</button>
					<a class="icon-btn" href={GITHUB_URL} aria-label="GitHub">
						<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={github}></path></svg>
					</a>
				</div>
			</nav>
			<div class="header-actions">
				<button class="icon-btn" type="button" data-theme-toggle aria-label="Switch to dark theme">
					<svg class="icon ic-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
					<svg class="icon ic-sun" viewBox="0 0 24 24"
						><circle cx="12" cy="12" r="4"></circle><path
							d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
						></path></svg
					>
				</button>
				<a class="icon-btn" href={GITHUB_URL} aria-label="GitHub">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={github}></path></svg>
				</a>
				<a class="btn btn-primary btn-sm" href="/docs/quickstart/">Quickstart</a>
				<button class="icon-btn menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
					<svg class="icon" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	const root = document.documentElement;
	const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
	const label = () => {
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		toggles.forEach((b) => b.setAttribute('aria-label', `Switch to ${next} theme`));
	};
	label();
	toggles.forEach((b) =>
		b.addEventListener('click', () => {
			const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('starlight-theme', next);
			} catch {}
			label();
		}),
	);

	const pill = document.querySelector('.pill-in');
	const menu = document.querySelector<HTMLButtonElement>('.menu-btn');
	const setOpen = (open: boolean) => {
		menu?.setAttribute('aria-expanded', String(open));
		pill?.classList.toggle('open', open);
	};
	menu?.addEventListener('click', () => setOpen(menu.getAttribute('aria-expanded') !== 'true'));
	document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
